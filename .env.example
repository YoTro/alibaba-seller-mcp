# ─────────────────────────────────────────────────────────────
# Alibaba.com International Station open platform credentials
# Get these from https://openapi.alibaba.com (App console → App Key / Secret)
# ─────────────────────────────────────────────────────────────
ALIBABA_APP_KEY=your_app_key
ALIBABA_APP_SECRET=your_app_secret

# OAuth redirect URI registered in your app console. The seller is sent here
# with a ?code=... after granting access.
ALIBABA_REDIRECT_URI=https://your-app.example.com/oauth/callback

# API gateway for the unified open.alibaba.com platform.
ALIBABA_GATEWAY=https://open-api.alibaba.com/rest
# Seller-authorization OAuth endpoint (per the open.alibaba.com docs).
# force_auth=true forces the login/consent screen each time.
ALIBABA_AUTHORIZE_URL=https://open-api.alibaba.com/oauth/authorize
ALIBABA_FORCE_AUTH=true
# HMAC signing algorithm advertised to the gateway. Almost always sha256.
ALIBABA_SIGN_METHOD=sha256

# ── API method names (confirm against YOUR app's authorized API list) ──────
# The gateway maps dotted method names to REST paths (dots → slashes).
# These defaults are the common ICBU (International Station) product APIs;
# override here if your app was granted different ones.
# Publishing is schema-based: schema.get -> fill -> schema.add / add.draft / update.
ALIBABA_METHOD_SCHEMA_GET=alibaba.icbu.product.schema.get
ALIBABA_METHOD_SCHEMA_ADD=alibaba.icbu.product.schema.add
ALIBABA_METHOD_SCHEMA_ADD_DRAFT=alibaba.icbu.product.schema.add.draft
ALIBABA_METHOD_SCHEMA_UPDATE=alibaba.icbu.product.schema.update
ALIBABA_METHOD_SCHEMA_RENDER_DRAFT=alibaba.icbu.product.schema.render.draft
# Photo-bank upload goes through the legacy TOP gateway (/sync, see
# ALIBABA_SYNC_GATEWAY). Verified working name: alibaba.icbu.photobank.upload —
# "alibaba.icbu.photobank.uploadimage" is rejected with InvalidApiPath.
ALIBABA_METHOD_PHOTO_UPLOAD=alibaba.icbu.photobank.upload
# ALIBABA_SYNC_GATEWAY=https://open-api.alibaba.com/sync

# ─────────────────────────────────────────────────────────────
# Anthropic (Claude) — brief copy, detail-page spec, social content
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Model for social content. Defaults to claude-opus-5.
SOCIAL_MODEL=claude-opus-5
# Soft ceiling on Claude tokens for ONE server session (0/unset = no limit).
# Bounds a runaway loop of AI calls — the only thing here that costs money per
# attempt. Checked before each call, so the last call may overshoot it.
# ALIBABA_MCP_AI_TOKEN_BUDGET=2000000

# ─────────────────────────────────────────────────────────────
# alibaba.com keyword ads (ads_search_keyword / ads_keyword_monopoly)
# ─────────────────────────────────────────────────────────────
# A browser's Cookie header for www.alibaba.com, pasted into a file — clears the
# slider check once it has been passed in that browser. No login needed.
# ALIBABA_MARKET_COOKIE_FILE=~/.alibaba_seller_mcp/market_cookie.txt
# Seconds between live search requests (default 10).
# ALIBABA_MARKET_MIN_INTERVAL=10
# Reuse a keyword's snapshot for this long before fetching again (default 24).
# ALIBABA_MARKET_CACHE_TTL_HOURS=24
# Buyer country the ads are targeted at (default US).
# ALIBABA_MARKET_COUNTRY=US
# Solve the anti-bot slider automatically and retry (default off). Cheapest route first;
# today only the browser tier passes, so it needs Camoufox + Playwright:
#   pip install 'alibaba-seller-mcp[browser]' && python -m camoufox fetch
# ALIBABA_MARKET_SOLVE_SLIDER=0
# Run the browser tier headless (default true); set false to watch it solve.
# ALIBABA_MARKET_SLIDER_HEADLESS=true
# OS fingerprint Camoufox presents (macos | windows | linux; default macos).
# ALIBABA_MARKET_SLIDER_OS=macos
# Template replay, tried before the browser (default on): re-signs blocks the browser
# tier captured from a real drag and passes over plain HTTP. Templates live in
# <state dir>/slider_templates and retire after this many uses (default 5).
# ALIBABA_MARKET_SLIDER_ALGO=1
# ALIBABA_MARKET_SLIDER_TEMPLATE_USES=5
# Headless Node signer — passes, but still needs a browser. Dev-only:
# ALIBABA_MARKET_SLIDER_HEADLESS_SIGN=0
# ALIBABA_MARKET_HEADLESS_SIGNER_DIR=          # path to a Node FireEye harness, if built

# ─────────────────────────────────────────────────────────────
# Local state (token store + usage log). Defaults to ~/.alibaba_seller_mcp
# ─────────────────────────────────────────────────────────────
# ALIBABA_MCP_STATE_DIR=/absolute/path/to/state

# Filesystem allowlist. Tools that take a local path (read_local_media,
# read_price_file, product manifests + their assets, generate_product_detail
# save_to) are confined to these directories. os.pathsep-separated
# (":" on macOS/Linux). Defaults to the current working directory.
# ALIBABA_MCP_ALLOWED_DIRS=/absolute/path/to/products:/another/allowed/dir
